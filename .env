# Copy to `.env` at this folder root for Docker Compose / local deploys.
# Compose loads only `.env` — this file is documentation only.

# Pixelcast client build: single-tenant UI (Visitor / Employee / Manager only). Wizard writes this on finalize.
DEPLOYMENT_MODE=client

# --- Mother platform (optional) ---
# Mother URL is hardcoded in app settings for CodeCanyon build.
# One-time Envato / purchase code for the first `mother_register` only.
# After a successful register, credentials are stored encrypted in the database;
# remove PURCHASE_CODE from the server environment when possible — keeping it long-term increases leak risk.
PURCHASE_CODE=
# Enable Celery tasks (heartbeat, usage) and optional entrypoint registration.
MOTHER_SYNC_ENABLED=False
# Send outbound support tickets via POST /api/gateway/ticket/ with X-Instance-Key (requires stored credentials).
# When false, tickets use the license-registry ingest path if the operator bridge is enabled.
MOTHER_TICKET_VIA_GATEWAY=False
# HTTP timeout (seconds) for all mother gateway requests.
MOTHER_HTTP_TIMEOUT_SECONDS=10

# Celery worker and beat need the same Redis and database variables as `backend`
# (CELERY_BROKER_URL, CELERY_RESULT_BACKEND, DB_*, REDIS_*, SECRET_KEY, etc.).

# Encrypted storage for mother API key reuses the notifications Fernet key:
# NOTIFICATION_ENCRYPTION_KEY=<url-safe base64 Fernet key>
